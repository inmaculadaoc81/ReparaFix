{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/blog.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "redirects": [
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/:wp(.*-sitemap\\d*\\.xml)",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/((?!(?:blog|politica-privacidad\\.html|politica-privacidad|aviso-legal\\.html|package\\.json|aviso-legal|sitemap\\.xml|vercel\\.json|index\\.html|README\\.txt|robots\\.txt|styles\\.css|script\\.js|_vercel|package|sitemap|assets|README|robots|script|styles|vercel|index|api)(?:[/.]|$)).+)",
      "destination": "/",
      "permanent": true
    }
  ]
}
