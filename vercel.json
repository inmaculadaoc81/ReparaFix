{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/:wp(.*-sitemap\\d*\\.xml)",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/((?!(?:politica-privacidad\\.html|politica-privacidad|aviso-legal\\.html|package\\.json|aviso-legal|sitemap\\.xml|vercel\\.json|index\\.html|README\\.txt|robots\\.txt|styles\\.css|script\\.js|_vercel|package|sitemap|assets|README|robots|script|styles|vercel|index|api)(?:[/.]|$)).+)",
      "destination": "/",
      "permanent": true
    }
  ]
}
